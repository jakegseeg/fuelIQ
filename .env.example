# ---- Server ----------------------------------------------------------------
# Port the API listens on (spec 5.3 uses 3001; default below is 4000 to match
# the Vite dev proxy in client/vite.config.ts — keep them in sync if you change it).
PORT=4000

# Database. Local dev uses SQLite automatically (server/data/fueliq.db); set this
# to run against PostgreSQL using server/sql/schema.postgres.sql.
DATABASE_URL=
# e.g. DATABASE_URL=postgres://user:pass@localhost:5432/fueliq

# Secret used to sign JWT auth tokens (HS256). Use a long random string in prod.
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic Claude API — enables AI workout plans, food suggestions, the weekly
# check-in, daily insights, and the nutrition chatbot. Optional: local
# deterministic fallbacks are used when unset.
ANTHROPIC_API_KEY=

# Open Food Facts requires a descriptive User-Agent on API requests.
OPEN_FOOD_FACTS_USER_AGENT=FuelIQ/1.0

# ---- Client (Vite) ----------------------------------------------------------
# In dev, Vite proxies /api to PORT above — this is mainly for production builds.
VITE_API_BASE_URL=http://localhost:4000

# ---- Optional (see SETUP.md) ------------------------------------------------
# Install on server workspace for full AI: npm install @anthropic-ai/sdk -w server
# Postgres (production): run server/sql/schema.postgres.sql then set DATABASE_URL
